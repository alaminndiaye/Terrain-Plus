# APP_URL: URL publique officielle de l'application (utiliser https:// en production)
APP_URL="https://terrain-plus.vercel.app"

# SUPPORT_DPO_EMAIL: Adresse de contact protection des données (CDP Sénégal)
SUPPORT_DPO_EMAIL="dpo@terrain-plus.sn"

# SESSION_SECRET: Clé secrète HMAC pour la signature des jetons de session (OBLIGATOIRE en production : openssl rand -hex 32)
SESSION_SECRET=""

# DB_PATH: Chemin vers la base de données SQLite locale (si DATABASE_URL n'est pas défini)
DB_PATH="./terrain_plus.db"

# RATE LIMITING DISTRIBUÉ SERVERLESS (Optionnel — sinon utilise automatiquement PostgreSQL rate_limit_buckets)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# SUPABASE + VERCEL (PostgreSQL & Storage pour déploiement serverless)
# Utiliser le Transaction Pooler Supabase (port 6543) pour Vercel :
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SECRET_KEY="your-supabase-secret-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_STORAGE_BUCKET="coach-diplomas"
SUPABASE_VIDEO_BUCKET="coach-videos"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-anon-key"

# ENVOI D'OTP RÉEL (Email via Resend et/ou Webhook SMS)
# Si ces variables ne sont pas définies, l'inscription active les comptes directement et les routes OTP renvoient 503.
RESEND_API_KEY=""
OTP_FROM_EMAIL="Terrain+ <no-reply@terrain-plus.sn>"
OTP_WEBHOOK_URL=""
OTP_WEBHOOK_TOKEN=""

# PROVISIONNEMENT INITIAL ADMIN & MINISTRE (utilisés uniquement si aucun compte de ce rôle n'existe)
BOOTSTRAP_ADMIN_EMAIL="admin@terrainplus.sn"
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_PHONE="+221770000001"
BOOTSTRAP_ADMIN_NOM="Administration"
BOOTSTRAP_ADMIN_PRENOM="Terrain+"

BOOTSTRAP_MINISTER_EMAIL=""
BOOTSTRAP_MINISTER_PASSWORD=""
BOOTSTRAP_MINISTER_PHONE="+221770000002"
BOOTSTRAP_MINISTER_NOM="Observatoire"
BOOTSTRAP_MINISTER_PRENOM="Ministère"
