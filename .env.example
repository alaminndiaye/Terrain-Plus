# Terrain+ — Configuration exemple (AUCUN SECRET RÉEL ICI)
# En local : copier vers .env.local
# Sur Vercel : reporter ces variables dans Settings -> Environment Variables

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# Supabase Cloud (obligatoire en production / test cloud)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Clés cryptographiques serveur (obligatoires sur Vercel — 64 caractères hexadécimaux = 32 octets)
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_SECRET=dev-session-secret-change-in-production-64-chars-minimum-value

# Paiement & Tarification (forfait unique 10 000 FCFA TTC : 9 000 FCFA médecin / 1 000 FCFA plateforme)
PAYMENT_ADAPTER=sandbox
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-in-production

# SMS OTP (sandbox en dev ; webhook / orange_sn / twilio en prod)
SMS_ADAPTER=sandbox
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Visio WebRTC STUN/TURN (JSON array of RTCIceServer)
NEXT_PUBLIC_WEBRTC_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]

# Administrateur initial créé par npm run seed
ADMIN_EMAIL=admin@terrainplus.sn
ADMIN_PHONE=+221770000001
ADMIN_PASSWORD=Admin1234!
