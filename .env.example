# APP_URL: URL d'hébergement de l'application
APP_URL="http://localhost:3000"

# SESSION_SECRET: Clé secrète HMAC pour la signature des jetons de session (à définir en production)
SESSION_SECRET="terrain-plus-dev-secret-change-in-production"

# DB_PATH: Chemin vers la base de données SQLite locale
DB_PATH="./terrain_plus.db"

# SUPABASE + VERCEL (PostgreSQL & Storage pour déploiement serverless)
# Utiliser le Transaction Pooler Supabase (port 6543) pour Vercel :
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SECRET_KEY="your-supabase-secret-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_STORAGE_BUCKET="coach-diplomas"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-anon-key"

# OTP : par défaut les codes OTP restent visibles à l'écran (comme en local) après déploiement.
# Passez à "true" uniquement lorsque vous aurez branché un envoi SMS/Email réel.
HIDE_DEMO_OTP="false"
